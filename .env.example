# ─── AI Learning Hub QA — Environment Variables ───────────────────────────────
# Copy this file to .env and update values for your environment.

# Frontend base URL (Next.js)
BASE_URL=http://localhost:3000

# Backend API base URL (FastAPI — direct, not through Next.js proxy)
API_BASE_URL=http://localhost:8000

# Ollama availability — set to 'true' only when Ollama is running with llama3.2
OLLAMA_AVAILABLE=false

# Known stable concept slug used as seed in tests
TEST_CONCEPT_SLUG=rag

# Guest user ID (hardcoded in app — do not change)
TEST_USER_ID=guest
